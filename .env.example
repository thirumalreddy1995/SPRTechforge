# Copy this file to .env.local for local development.
# .env.local is gitignored. CI builds inject these via GitHub Actions secrets.
#
# Where to find the values: Firebase Console → Project Settings → Your apps → SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Email bridge (Google Apps Script). See SETUP-EMAIL.md for deploy steps.
# VITE_EMAIL_ENDPOINT is the deployed Apps Script Web App URL, e.g.
#   https://script.google.com/macros/s/AKfycb.../exec
# VITE_EMAIL_SHARED_SECRET is whatever you put in Script Properties as SHARED_SECRET.
VITE_EMAIL_ENDPOINT=
VITE_EMAIL_SHARED_SECRET=
